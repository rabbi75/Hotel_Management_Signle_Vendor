###############################################################################
# Application
###############################################################################
APP_NAME="Hotel Management Single Vendor"
APP_ENV=local
APP_KEY=base64:isLBm8p1qeZdTBU3dYDnfFVmpo8jakMduRZOJmAifC4=
APP_DEBUG=true
APP_INSTALLED=true
APP_DEMO_MODE=false
APP_URL=http://localhost:8000

# Web installer lock. Fresh packages ship false; set true after /install completes.
APP_INSTALLED=false
APP_DEMO_MODE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database - MySQL 8
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_management_signle_vendor
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Cache / Session / Queue - Redis
# The `redis` PHP extension is optional: REDIS_CLIENT=predis is a pure-PHP
# client and is the default so the kit runs on a stock Windows/Laragon install.
###############################################################################
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=

QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Broadcasting - Pusher
# Leave BROADCAST_CONNECTION=log until Pusher credentials are supplied; every
# realtime feature then degrades to a no-op instead of erroring.
###############################################################################
BROADCAST_CONNECTION=log

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

###############################################################################
# Mail - Mailpit ships with Laragon: SMTP on 1025, web UI on 8025
###############################################################################
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Filesystem - local | s3 (the s3 driver also serves Cloudflare R2)
###############################################################################
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# Search - Scout (database | meilisearch | algolia)
###############################################################################
SCOUT_DRIVER=database
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

###############################################################################
# Starter kit
###############################################################################
SAAS_SINGLE_VENDOR=true
SAAS_REGISTRATION_ENABLED=false
SAAS_EMAIL_VERIFICATION_REQUIRED=true
SAAS_TWO_FACTOR_ENABLED=true
SAAS_DEFAULT_TIMEZONE=UTC
SAAS_DEFAULT_CURRENCY=USD
SAAS_TRIAL_DAYS=14

TELESCOPE_ENABLED=false

###############################################################################
# Social login (driver contract wired, credentials optional)
###############################################################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

###############################################################################
# Billing
# `manual` records subscriptions and invoices without contacting a processor,
# so the kit is fully usable and testable with no Stripe account.
###############################################################################
SAAS_BILLING_ENABLED=false
SAAS_BILLING_GATEWAY=manual
SAAS_BILLING_GRACE_DAYS=3
SAAS_INVOICE_PREFIX=INV-

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

###############################################################################
# Media library
###############################################################################
SAAS_MEDIA_DISK=local
SAAS_MEDIA_MAX_KB=51200
SAAS_MEDIA_OPTIMIZE=true

###############################################################################
# Chat / CMS / Blog / SEO
###############################################################################
SAAS_CHAT_MAX_ATTACHMENT_KB=10240
SAAS_BLOG_COMMENTS=false
SAAS_SEO_TITLE_SUFFIX=
SAAS_SEO_OG_IMAGE=
SAAS_SEO_TWITTER=

# Leave false until the site is ready to be indexed.
SAAS_SEO_INDEXABLE=false

###############################################################################
# Public API
###############################################################################
SAAS_API_TOKEN_DAYS=365
SAAS_API_LOG_REQUESTS=true
SAAS_API_LOG_RETENTION_DAYS=30

# Request/response bodies can contain personal data — opt in deliberately.
SAAS_API_LOG_BODIES=false

###############################################################################
# AI providers
# Model ids are exact, complete strings — never append a date suffix.
###############################################################################
SAAS_AI_ENABLED=true
SAAS_AI_PROVIDER=anthropic
SAAS_AI_MAX_TOKENS=4096
SAAS_AI_CREDITS_ENABLED=true
SAAS_AI_MONTHLY_CREDITS=1000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_THINKING=adaptive
ANTHROPIC_EFFORT=high

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROK_API_KEY=
GROK_MODEL=grok-2-latest
