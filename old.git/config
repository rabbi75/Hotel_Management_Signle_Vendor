[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = git@github.com:rabbi75/Hotel_Management_Sass.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "feature/hotel-management"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/feature/hotel-management
[branch "hotel_workspace"]
	remote = origin
	merge = refs/heads/hotel_workspace
	vscode-merge-base = origin/feature/hotel-management
[branch "ai"]
	vscode-merge-base = origin/hotel_workspace
	remote = origin
	merge = refs/heads/ai
