{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "salebot/saas-starter-kit",
    "type": "project",
    "description": "Production-ready, enterprise-grade Hotel Management built on Laravel, Inertia and React.",
    "keywords": ["laravel", "react", "inertia", "saas", "starter-kit"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "anthropic-ai/sdk": "^0.37",
        "inertiajs/inertia-laravel": "^3.1",
        "intervention/image-laravel": "^4.1",
        "laravel/cashier": "^16.6",
        "laravel/fortify": "^1.37",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.3",
        "laravel/socialite": "^5.28",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.35",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^3.5",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-activitylog": "^4.12.3",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-sitemap": "^8.0",
        "spatie/laravel-sluggable": "^4.0",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/telescope": "^5.20",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.5.12",
        "rector/rector": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force --seed",
            "@php artisan storage:link",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "fix": [
            "@php vendor/bin/pint",
            "@php vendor/bin/rector process"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "suggest": {
        "laravel/horizon": "Redis queue dashboard for production. Requires ext-pcntl, so it cannot be installed on Windows."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
